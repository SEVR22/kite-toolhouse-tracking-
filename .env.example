# Production uses remote. Mock is allowed only with NODE_ENV=development
# and STATION_DATA_SOURCE=mock. Read only on the server.
STATION_DATA_SOURCE=remote

# Required for remote mode: the actual base address of the Oracle FastAPI server.
# It must expose GET /stations/station-01/state using the StationState contract.
STATION_BACKEND_URL=

# Optional server-side bearer credential for reading your backend.
# Never prefix this with NEXT_PUBLIC_.
STATION_BACKEND_TOKEN=

# A state older than this is presented as stale to visitors.
NEXT_PUBLIC_STATION_STALE_AFTER_MS=15000
NEXT_PUBLIC_STATION_POLL_MS=1500
