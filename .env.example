# mock (default) or remote. Read only on the server.
STATION_DATA_SOURCE=mock

# Required only when STATION_DATA_SOURCE=remote. This base URL should expose
# GET /stations/:stationId/state using the public StationState contract.
STATION_BACKEND_URL=https://your-backend.example.com

# Optional server-side bearer credential for reading your backend.
# Never prefix this with NEXT_PUBLIC_.
STATION_BACKEND_TOKEN=

# A state older than this is presented as stale to visitors.
NEXT_PUBLIC_STATION_STALE_AFTER_MS=15000
NEXT_PUBLIC_STATION_POLL_MS=1500
